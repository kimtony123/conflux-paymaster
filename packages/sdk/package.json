{
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "name": "conflux-paymaster-sdk",
  "version": "1.0.0",
  "description": "Gasless transactions SDK for Conflux eSpace",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "ethers": "^6.9.0"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "viem": "^2.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "conflux",
    "espace",
    "account-abstraction",
    "erc-4337",
    "gasless",
    "web3"
  ],
  "author": "Conflux Paymaster",
  "license": "MIT"
}
