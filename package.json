{
  "name": "conflux-paymaster",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:contracts\" \"npm run dev:sdk\"",
    "build": "npm run build --workspaces",
    "build:contracts": "npm run build --workspace=@conflux-paymaster/contracts",
    "build:sdk": "npm run build --workspace=@conflux-paymaster/sdk",
    "build:backend": "npm run build --workspace=@conflux-paymaster/backend",
    "contracts:compile": "npm run compile --workspace=@conflux-paymaster/contracts",
    "contracts:test": "npm run test --workspace=@conflux-paymaster/contracts",
    "contracts:deploy": "npm run deploy:testnet --workspace=@conflux-paymaster/contracts",
    "contracts:deploy:mainnet": "npm run deploy:mainnet --workspace=@conflux-paymaster/contracts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
